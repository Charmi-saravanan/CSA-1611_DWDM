### Load required packages
install.packages(c("arules","e1071","rpart","HSAUR3"))
library(arules)
library(e1071)
library(rpart)
library(HSAUR3)

### 1. Apriori & FP-Growth (support=3, confidence=50%)
transactions <- list(
  c("M","O","N","K","E","Y"),
  c("D","O","N","K","E","Y"),
  c("M","A","K","E"),
  c("M","U","C","K","Y"),
  c("C","O","O","K","I","E")
)
trans <- as(transactions, "transactions")

rules_apriori <- apriori(trans, parameter=list(supp=0.3, conf=0.5))
inspect(rules_apriori)

frequent_items <- eclat(trans, parameter=list(supp=0.3))
inspect(frequent_items)

### 2. Max number of rules & frequent itemsets
items <- c("M","O","N","K","E","Y","D","A","U","C","I")
n_items <- length(unique(items))
max_rules <- 3^n_items - 2^(n_items+1) + 1
max_rules
max_itemset_size <- n_items
max_itemset_size

### 3. Bayes Classification & Decision Tree (diabetes.csv)
diabetes <- read.csv("diabetes.csv")
model_nb <- naiveBayes(Outcome ~ ., data=diabetes)
pred_nb <- predict(model_nb, diabetes)
table(pred_nb, diabetes$Outcome)

model_dt <- rpart(Outcome ~ ., data=diabetes, method="class")
plot(model_dt); text(model_dt)

